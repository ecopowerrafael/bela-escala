# .env.production - Configuração para VPS Ubuntu
NODE_ENV=production
PORT=3001

# Database
DATABASE_URL=postgresql://admin:mestre_escala_2026@db:5432/bela_escala?schema=public

# JWT & Security
JWT_SECRET=bela-escala-jwt-secret-production-key-2026-$(date +%s)

# Redis
REDIS_URL=redis://redis:6379

# MinIO S3 Storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bela-escala

# OpenAI (ChatBot)
OPENAI_API_KEY=your-api-key-here

# Frontend API URL (altere para seu domínio)
NEXT_PUBLIC_API_URL=http://localhost:3000
